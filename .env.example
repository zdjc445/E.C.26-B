# 识价镜 Agent 环境配置示例
# 复制为 .env 并按部署环境填写。外部地址、Token、Collection、模型标识符和数据路径
# 没有代码默认值：使用真实适配器时缺失会启动失败并列出精确缺失项。
# 算法类参数（超时、重试、阈值）有方案 §23 定义的默认值，可按需覆盖。

SHIJIAJING_ENV=dev

# --- 模型 Provider（OpenAI-compatible，如 Ark）---
# 使用真实适配器（示例、评测 --live、make_deps）时必须配置，缺失启动即失败。
ARK_API_KEY=
ARK_BASE_URL=
ARK_VISION_MODEL=
ARK_TEXT_MODEL=
# 文本向量与图像向量模型（由 Embedding Provider 契约提供）
EMBEDDING_MODEL=

# --- Milvus ---
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=

# --- Checkpoint ---
# 开发：sqlite（文件路径）；生产：postgres（DSN）
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DSN=

# --- Trace ---
# 当前支持：structlog（默认）；opentelemetry 可扩展
TRACE_BACKEND=structlog
TRACE_DSN=

# --- 数据文件 ---
# taxonomy.json 路径（默认使用包内置数据文件）
TAXONOMY_PATH=
# 本地商品快照（JSONL，本地词法降级索引使用；样例数据位于 tests/fixtures）
LOCAL_PRODUCT_SNAPSHOT_PATH=

# --- 运行参数（均有方案默认值）---
VISION_TIMEOUT_SECONDS=30
TEXT_MODEL_TIMEOUT_SECONDS=15
RETRIEVAL_TIMEOUT_SECONDS=3
TURN_TIMEOUT_SECONDS=60
MAX_MODEL_REPAIRS=2
MAX_NETWORK_ATTEMPTS=2
MAX_WORKFLOW_STEPS=40
RETRIEVAL_TOP_K_PER_CHANNEL=100
RETRIEVAL_UNION_LIMIT=200
MATCHING_CANDIDATE_LIMIT=60
BRAND_HARD_FILTER_CONFIDENCE=0.85
MODEL_HARD_FILTER_CONFIDENCE=0.90
SAME_ITEM_ACCEPT_THRESHOLD=0.82
SAME_ITEM_REVIEW_THRESHOLD=0.68

# Copy this file to .env for local configuration.
# Never commit real credentials.

# Backend base URL (used by Flutter app)
EC26B_API_BASE_URL=http://localhost:8080

# AI provider mode: "mock" (default) or "ark"
AI_PROVIDER=mock

# Ark AI provider (only used when AI_PROVIDER=ark)
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Ecommerce API master switch
ECOMMERCE_API_ENABLED=false

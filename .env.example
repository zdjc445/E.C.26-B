# 识价镜 Agent 环境配置示例
# 复制为 .env 并按部署环境填写。外部地址、Token、Collection、模型标识符和数据路径
# 没有代码默认值：使用真实适配器时缺失会启动失败并列出精确缺失项。
# 算法类参数（超时、缓存 TTL、重试、阈值）有方案 §13 定义的默认值，可按需覆盖。

SHIJIAJING_ENV=dev

# --- 模型 Provider（OpenAI-compatible，如 Ark）---
# 使用真实适配器（示例、评测 --live、make_deps）时必须配置，缺失启动即失败。
SHIJIAJING_ARK_API_KEY=
SHIJIAJING_ARK_BASE_URL=
SHIJIAJING_ARK_VISION_MODEL=
SHIJIAJING_ARK_TEXT_MODEL=
# 文本向量与图像向量模型（由 Embedding Provider 契约提供）
SHIJIAJING_EMBEDDING_MODEL=

# --- Milvus ---
SHIJIAJING_MILVUS_URI=
SHIJIAJING_MILVUS_TOKEN=
SHIJIAJING_MILVUS_COLLECTION=

# --- Checkpoint ---
# 开发：sqlite（文件路径）；生产：postgres（DSN）
SHIJIAJING_CHECKPOINT_BACKEND=sqlite
SHIJIAJING_CHECKPOINT_DSN=
# Supervisor Planner 默认关闭；可使用 shadow 只评估候选计划
SHIJIAJING_SUPERVISOR_MODEL=
SHIJIAJING_SUPERVISOR_PLANNER_MODE=off
SHIJIAJING_SUPERVISOR_PLANNER_TIMEOUT_SECONDS=8
SHIJIAJING_SUPERVISOR_PLANNER_MAX_REPAIRS=1
SHIJIAJING_SUPERVISOR_PLANNER_MAX_TOKENS=1500
SHIJIAJING_MAX_AGENT_TASKS=32
SHIJIAJING_MAX_SUPERVISOR_REPLANS=2
SHIJIAJING_AGENT_TASK_TIMEOUT_SECONDS=30
SHIJIAJING_REQUEST_LEDGER_BACKEND=sqlite
SHIJIAJING_REQUEST_LEDGER_DSN=

# --- Trace ---
# 当前支持：structlog（默认）或 opentelemetry（需要 OTLP HTTP endpoint）
SHIJIAJING_TRACE_BACKEND=structlog
SHIJIAJING_TRACE_DSN=

# --- 数据文件 ---
# taxonomy.json 路径（默认使用包内置数据文件）
SHIJIAJING_TAXONOMY_PATH=
# 本地商品快照（JSONL，本地词法降级索引使用；样例数据位于 tests/fixtures）
SHIJIAJING_LOCAL_PRODUCT_SNAPSHOT_PATH=

# --- 运行参数（均有方案默认值）---
SHIJIAJING_VISION_TIMEOUT_SECONDS=30
SHIJIAJING_TEXT_MODEL_TIMEOUT_SECONDS=15
SHIJIAJING_RETRIEVAL_TIMEOUT_SECONDS=3
SHIJIAJING_TURN_TIMEOUT_SECONDS=60
SHIJIAJING_VISION_CACHE_TTL_SECONDS=2592000
SHIJIAJING_INTENT_CACHE_TTL_SECONDS=604800
SHIJIAJING_QUERY_REWRITE_CACHE_TTL_SECONDS=604800
SHIJIAJING_RETRIEVAL_CACHE_TTL_SECONDS=300
SHIJIAJING_EXPLANATION_CACHE_TTL_SECONDS=86400
SHIJIAJING_POSTGRES_POOL_MIN_SIZE=1
SHIJIAJING_POSTGRES_POOL_MAX_SIZE=4
SHIJIAJING_POSTGRES_POOL_TIMEOUT_SECONDS=30
SHIJIAJING_MAX_MODEL_REPAIRS=2
SHIJIAJING_MAX_NETWORK_ATTEMPTS=2
SHIJIAJING_RETRIEVAL_TOP_K_PER_CHANNEL=100
SHIJIAJING_RETRIEVAL_UNION_LIMIT=200
SHIJIAJING_MATCHING_CANDIDATE_LIMIT=60
# 商品归一化固定使用动态 Schema，无模式开关
SHIJIAJING_DYNAMIC_SCHEMA_BATCH_SIZE=60
SHIJIAJING_DYNAMIC_SCHEMA_CONCEPT_MIN_CONFIDENCE=0.90
SHIJIAJING_DYNAMIC_SCHEMA_ROLE_MIN_CONFIDENCE=0.90
SHIJIAJING_DYNAMIC_SCHEMA_ROLE_MIN_SUPPORT=2
SHIJIAJING_DYNAMIC_SCHEMA_MAX_CONCEPTS=16
SHIJIAJING_DYNAMIC_SCHEMA_MAX_ATTRIBUTES_PER_CONCEPT=64
SHIJIAJING_DYNAMIC_SCHEMA_CACHE_TTL_SECONDS=604800
SHIJIAJING_DYNAMIC_CANONICALIZATION_BATCH_SIZE=20
SHIJIAJING_DYNAMIC_CANONICALIZATION_FIELD_MIN_CONFIDENCE=0.80
SHIJIAJING_BRAND_HARD_FILTER_CONFIDENCE=0.85
SHIJIAJING_MODEL_HARD_FILTER_CONFIDENCE=0.90
SHIJIAJING_SAME_ITEM_ACCEPT_THRESHOLD=0.88
SHIJIAJING_SAME_ITEM_REVIEW_THRESHOLD=0.74

# --- 二期工程能力 ---
SHIJIAJING_MEMORY_ENABLED=false
# 内部灰度开关：memory_enabled=true 后可先只开 recall，观察后再开 commit。
SHIJIAJING_MEMORY_RECALL_ENABLED=true
SHIJIAJING_MEMORY_COMMIT_ENABLED=true
SHIJIAJING_MEMORY_BACKEND=disabled
SHIJIAJING_MEMORY_DSN=
SHIJIAJING_MEMORY_RECALL_LIMIT=20
SHIJIAJING_RECENT_TURNS_LIMIT=6
SHIJIAJING_RECENT_TURNS_MAX_BYTES=65536
SHIJIAJING_MEMORY_PURGE_ENABLED=false
SHIJIAJING_MEMORY_MUTATION_LEDGER_RETENTION_DAYS=90
SHIJIAJING_HITL_ENABLED=false
SHIJIAJING_RECOGNITION_REVIEW_THRESHOLD=0.70
SHIJIAJING_MEMORY_CONFIRMATION_REQUIRED=true
SHIJIAJING_CACHE_BACKEND=disabled
SHIJIAJING_CACHE_DSN=
SHIJIAJING_RETRIEVAL_FUSION_STRATEGY=weighted
SHIJIAJING_RETRIEVAL_RRF_K=60
SHIJIAJING_RETRIEVAL_RERANK_LIMIT=60
SHIJIAJING_RETRIEVAL_RERANK_ENABLED=false
SHIJIAJING_RETRIEVAL_INDEX_VERSION=
SHIJIAJING_EVENT_STORE_BACKEND=disabled
SHIJIAJING_EVENT_STORE_DSN=

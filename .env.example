# Copy this file to .env for local secret management if your shell or IDE can load env files.
# Never commit real credentials. The application reads these values from environment variables.

# Backend runtime
APP_JWT_SECRET=change-me-to-a-long-random-secret
UPLOAD_DIR=uploads
MOCK_DATA_DIR=mock-data

# Optional Ark AI provider
AI_PROVIDER=mock
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Official ecommerce API master switch
ECOMMERCE_API_ENABLED=false
ECOMMERCE_API_TIMEOUT_SECONDS=8

# Pinduoduo Open Platform / DDK
PDD_API_ENABLED=false
PDD_API_BASE_URL=https://gw-api.pinduoduo.com/api/router
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_API_TYPE=pdd.ddk.goods.search
PDD_PID=
PDD_CUSTOM_PARAMETERS=

# JD JOS / JD Union
JD_API_ENABLED=false
JD_API_BASE_URL=https://api.jd.com/routerjson
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=
JD_API_METHOD=jd.union.open.goods.query
JD_PARAM_JSON_NAME=360buy_param_json
JD_SITE_ID=
JD_POSITION_ID=

# Live official API smoke test
ECOMMERCE_LIVE_TEST=false
ECOMMERCE_LIVE_QUERY=hair dryer
ECOMMERCE_LIVE_PLATFORMS=
ECOMMERCE_LIVE_SORT_BY=price_asc
ECOMMERCE_LIVE_MIN_PRICE=
ECOMMERCE_LIVE_MAX_PRICE=
ECOMMERCE_LIVE_WITH_COUPON=
ECOMMERCE_LIVE_OFFICIAL_ONLY=
ECOMMERCE_LIVE_SELF_OPERATED_ONLY=
ECOMMERCE_LIVE_REPORT_PATH=

# Optional PostgreSQL profile
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/shopping_agent
POSTGRES_USER=shopping_agent
POSTGRES_PASSWORD=shopping_agent

# Copy this file to .env for local configuration.
# Never commit real credentials.

# Backend base URL (used by Flutter app)
EC26B_API_BASE_URL=http://localhost:8080

# AI provider mode: "mock" (default) or "ark"
AI_PROVIDER=mock

# Ark AI provider (only used when AI_PROVIDER=ark)
ARK_API_KEY=
ARK_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Product source mode: "public-dataset-platforms" (default) or "public-dataset-only"
PRODUCT_SOURCE_MODE=public-dataset-platforms

# Persistence store: "memory" (default) or "postgres"
APP_PERSISTENCE_STORE=memory

# Public sample products are stored in backend resources; no real ecommerce API credentials are required.
